# ── Required ──────────────────────────────────────────────────────────────
NVIDIA_API_KEY=nvapi

# ── Optional overrides ────────────────────────────────────────────────────
# LLM model (default: meta/llama-3.1-70b-instruct)
# Other NVIDIA-supported options: mistralai/mixtral-8x22b-instruct-v0.1
#                                  nvidia/llama-3.1-nemotron-70b-instruct
CHAT_MODEL=meta/llama-3.1-70b-instruct

# Embedding model (default: nvidia/nv-embedqa-e5-v5)
# Other options: nvidia/nv-embed-v1, baai/bge-m3
EMBED_MODEL=nvidia/nv-embedqa-e5-v5

# ChromaDB persistence directory (default: ./chroma_db)
CHROMA_PERSIST_DIR=./chroma_db

# ChromaDB collection name (default: yt_chunks)
CHROMA_COLLECTION=yt_chunks
